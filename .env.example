# Copy to .env (git-ignored) and fill in. Never commit .env.

# ── LLM provider: these three lines are the ONLY difference between a laptop model and a datacentre one ──
# OpenRouter (hosted, free): key from https://openrouter.ai/keys, and turn ON both free-endpoint switches at
# https://openrouter.ai/settings/privacy first, or every free model answers 404.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-key-here
LLM_MODEL=openrouter/free
# Ollama (local, unlimited): install it, then `ollama pull gemma3:1b`, and use instead:
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama
# LLM_MODEL=gemma3:1b

# ── Database (same as A3). Leave DATABASE_URL commented out to use the SQLite file tasks.db (no Docker needed).
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks
# DATABASE_URL=postgresql://tasks:change-me@localhost:5432/tasks
